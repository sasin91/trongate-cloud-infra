# EXAMPLE ONLY. The registry's existing `pull` user (the same credential the
# nodes use, from registries_config), so image-reflector-controller can list
# the tags of registry.trongate.cloud/platform/trongate-cloud-worker.
#
#   kubectl create secret docker-registry registry-pull -n flux-system \
#     --docker-server=registry.trongate.cloud --docker-username=pull \
#     --docker-password='<pull password>' --dry-run=client -o yaml \
#     > registry-pull.sops.yaml
#   sops --encrypt --in-place registry-pull.sops.yaml
#
# then uncomment it in kustomization.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: registry-pull
  namespace: flux-system
type: kubernetes.io/dockerconfigjson
stringData:
  .dockerconfigjson: |
    {"auths":{"registry.trongate.cloud":{"username":"pull","password":"REPLACE","auth":"REPLACE_WITH_BASE64_OF_pull:PASSWORD"}}}
