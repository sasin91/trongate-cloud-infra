# EXAMPLE ONLY. Copy to registry-config.sops.yaml, fill in, encrypt with
# `sops --encrypt --in-place`, then uncomment it in kustomization.yaml.
#
#   http-secret   openssl rand -hex 32
#   htpasswd      two bcrypt entries, one per line:
#                   htpasswd -nbB push <push password>   (worker: registry-push)
#                   htpasswd -nbB pull <pull password>   (nodes: registries_config)
#   bucket, access-key, secret-key
#                 the registry bucket in fsn1 and an object-storage credential
#                 (Hetzner console; the CLI cannot create one)
apiVersion: v1
kind: Secret
metadata:
  name: registry-config
  namespace: registry
type: Opaque
stringData:
  http-secret: REPLACE_WITH_RANDOM_HEX
  htpasswd: |
    push:REPLACE_WITH_BCRYPT_HASH
    pull:REPLACE_WITH_BCRYPT_HASH
  bucket: trongate-cloud-fsn1-registry
  access-key: REPLACE_WITH_OBJECT_STORAGE_ACCESS_KEY
  secret-key: REPLACE_WITH_OBJECT_STORAGE_SECRET_KEY
