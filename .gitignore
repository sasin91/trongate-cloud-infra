# Never commit real variable values. The example file is committed; this is not.
# terraform.tfvars carries the object-storage credentials and the state
# passphrase — the passphrase in particular is the key every encrypted secret
# in this repository is protected by.
*.tfvars
!*.tfvars.example
# TRONGATE-CLOUD: the profile file holds shape only, never credentials.
!infrastructure/hetzner/trongate-cloud.auto.tfvars
# Partial backend config (bucket names and endpoint); the example is committed.
backend.hcl
# Flux's read-only deploy keys, created next to the repo by TRONGATE-CLOUD.md 5.2.
/infra-deploy-key*
/trongate-cloud-deploy-key*
/known_hosts

# State should never be local. If these appear, the backend is not configured,
# and a configuration that cannot manage what it built is worse than none.
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl.bak
crash.log
crash.*.log

# The age private key. This is the one secret applied by hand and the one that
# cannot be encrypted; everything else in this repository is encrypted to it.
# Committing it makes every encrypted file in the history plaintext.
*.agekey
age.key
key.txt

# Kubeconfigs emitted by the node layer.
*kubeconfig*
!*kubeconfig*.example

# Local tooling
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
__pycache__/
*.pyc
